# Run python3 scripts/configure-local.py for generated LOCAL credentials.
# Replace placeholders securely for deployment; never use these literal values.
NODE_ENV=development
WEB_BIND_IP=127.0.0.1
WEB_PORT=8080
MEDIA_BIND_IP=127.0.0.1
POSTGRES_USER=room_admin
POSTGRES_PASSWORD=replace-with-generated-password
POSTGRES_APP_USER=room_app
POSTGRES_APP_PASSWORD=replace-with-generated-app-password
POSTGRES_DB=room_db
LIVEKIT_API_KEY=replace-with-generated-api-key
LIVEKIT_API_SECRET=replace-with-generated-secret
LIVEKIT_PUBLIC_URL=ws://localhost:7880
ALLOWED_ORIGINS=http://localhost:8080
ENABLE_DEV_MEDIA_TOKENS=false
RATE_LIMIT_IP_MAX=60
# Production requires NODE_ENV=production, HTTPS/WSS and real DNS/certificates.
APP_DOMAIN=room.example.invalid
MEDIA_DOMAIN=media.example.invalid
# Optional transcription profile: pre-provision reviewed model in /models/model.
ASR_MODEL_DIR=./.local/models
