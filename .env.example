# Development only. Copy to .env; generate different credentials before any deployment.
POSTGRES_USER=room_user
POSTGRES_PASSWORD=room_local_database_only
POSTGRES_DB=room_db
DATABASE_URL=postgres://room_user:room_local_database_only@localhost:5432/room_db
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=room-audio
S3_ACCESS_KEY_ID=room_local_storage
S3_SECRET_ACCESS_KEY=room_local_storage_only_change_me
WEB_ORIGIN=http://localhost:5173
PORT=3000
WORKER_PORT=3001
JOB_LEASE_SECONDS=60
RETENTION_DAYS=30
LOG_LEVEL=info
